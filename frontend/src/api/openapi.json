  "info": {
    "description": "Empirical research and directional market-sentiment classification for US Equities, ETFs, Forex pairs, Cryptocurrencies, and Commodities.",
    "title": "Market Sentiment Analysis API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analysis/{run_id}": {
      "get": {
        "description": "Fetch complete persisted diagnostic analysis and evidence chain for a specific run.",
        "operationId": "get_analysis_result_api_v1_analysis__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Analysis Result"
      }
    },
    "/api/v1/analyze": {
      "post": {
        "description": "Analyzes current-day market sentiment for a US-listed equity or ETF.\n- If cached within the session bucket: returns 200 OK with full result instantly.\n- If uncached: creates an async job and returns 202 Accepted with SSE event stream URL.",
        "operationId": "analyze_ticker_api_v1_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnalysisResult"
                    },
                    {
                      "$ref": "#/components/schemas/JobCreatedResponse"
                    }
                  ],
                  "title": "Response Analyze Ticker Api V1 Analyze Post"
                }
              }
            },
            "description": "Instant cache hit with full AnalysisResult"
          },
          "202": {
            "description": "Job created, processing in background"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze Ticker"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Health check endpoint validating SQLite, FinBERT initialization, and OpenRouter config.",
        "operationId": "get_health_status_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health Status"
      }
    },
    "/api/v1/history": {
      "get": {
        "description": "Retrieve recent searches and historical sentiment verdicts.",
        "operationId": "get_search_history_api_v1_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecentRunSummary"
                  },
                  "title": "Response Get Search History Api V1 History Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Search History"
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "description": "Polling fallback for background job progression.",
        "operationId": "get_job_status_api_v1_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Job Status"
      }
    },
    "/api/v1/jobs/{job_id}/events": {
      "get": {
        "description": "Server-Sent Events (SSE) stream for real-time live pipeline progress.\n    Emits progress, completed, and failed events with periodic heartbeats (: ping\n\n).",
        "operationId": "stream_job_events_api_v1_jobs__job_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream Job Events"
      }
    }
  }
}
