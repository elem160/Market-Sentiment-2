# =====================================================================
# SentimentPulse / Market Sentiment 2 Environment Configuration
# =====================================================================

# Server Environment
# Application execution mode (development, staging, production)
APP_ENV=development
# Bind address for uvicorn server
APP_HOST=127.0.0.1
# Bind port for uvicorn server
APP_PORT=8000

# Database & Schema Migrations
# Database connection string (SQLite relative paths resolve to project BASE_DIR)
DATABASE_URL=sqlite:///./data/sentiment.db
# Run Alembic migrations programmatically to head during application startup
RUN_MIGRATIONS_ON_STARTUP=true

# Scoring Algorithm Version (Decision Integrity & Cache Keying)
ALGORITHM_VERSION=2

# Logging
# Root application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Model Identifiers
# HuggingFace transformer model ID for local FinBERT classification
FINBERT_MODEL_NAME=ProsusAI/finbert
# Batch inference chunk size for FinBERT inference
FINBERT_BATCH_SIZE=16
# Preload FinBERT model into memory on startup task
FINBERT_PRELOAD=true
# Torch intra-op thread count (0 = auto-detect CPU cores)
FINBERT_TORCH_THREADS=0

# Primary OpenRouter LLM model ID for catalyst synthesis
LLM_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free
# Fallback OpenRouter LLM model ID if primary model fails or times out
LLM_FALLBACK_MODEL_ID=nvidia/nemotron-3-super-120b-a12b:free
# Enable/disable LLM catalyst synthesis stage
ENABLE_LLM=true
# Per-request HTTP timeout in seconds for OpenRouter API calls
LLM_REQUEST_TIMEOUT_SECONDS=25.0
# Hard timeout deadline across all LLM attempts (primary + fallback)
LLM_TIMEOUT_SECONDS=30.0
# Retry count for retryable 429/5xx errors
LLM_MAX_RETRIES=1
# Force JSON object formatting response from OpenRouter
LLM_JSON_MODE=true
# Optional reasoning effort header for supporting reasoning models
LLM_REASONING_EFFORT=

# External Provider Credentials
# OpenRouter API key for catalyst verification and reasoning
OPENROUTER_API_KEY=

# Security & Networking
# Optional API key guard for write/analysis endpoints (null = disabled)
API_KEY=
# Allow unauthenticated read access to /history and /analysis/{id}
PUBLIC_HISTORY=true
# Trust reverse proxy X-Forwarded-For headers
TRUST_PROXY_HEADERS=false
# Comma-separated list or JSON array of trusted proxy CIDRs/IPs
TRUSTED_PROXY_IPS=
# Allowed origins for CORS requests
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Budget & Token Controls
# Maximum retained articles per analysis run after deduplication
MAX_RETAINED_ARTICLES=350
# Maximum articles eligible for LLM catalyst synthesis consideration
MAX_LLM_CANDIDATES=100
# Maximum prompt tokens allowed for LLM synthesis request
MAX_PROMPT_TOKENS=8000
# Maximum completion tokens generated by LLM
MAX_COMPLETION_TOKENS=1000
# Maximum estimated cost per single analysis run in USD
MAX_COST_PER_RUN_USD=0.05
# Daily UTC spending budget for OpenRouter LLM synthesis in USD
LLM_DAILY_BUDGET_USD=1.00
# Maximum excluded article samples stored per exclusion reason in evidence explorer
MAX_EXCLUDED_SAMPLES_PER_REASON=20
# Days to retain analysis runs before maintenance pruning
RUN_RETENTION_DAYS=30
# Background maintenance interval in seconds (default: 3600 = 1 hour)
MAINTENANCE_INTERVAL_SECONDS=3600.0

# Rate Limiting
# Allowed analysis requests per minute per client IP
RATE_LIMIT_ANALYSIS_PER_MINUTE=15
# Allowed job status and SSE event requests per minute per client IP
RATE_LIMIT_JOBS_PER_MINUTE=60
# Allowed read and history requests per minute per client IP
RATE_LIMIT_READ_PER_MINUTE=120

# Pipeline Execution & Timeouts
# Total analysis pipeline timeout deadline in seconds
PIPELINE_TIMEOUT_SECONDS=90
# Maximum concurrent analysis pipelines executing simultaneously
MAX_CONCURRENT_PIPELINES=2
# Maximum seconds a job may wait queued for worker semaphore before timing out
JOB_QUEUE_TIMEOUT_SECONDS=120.0
# Periodic SSE keepalive comment interval in seconds
SSE_HEARTBEAT_SECONDS=15.0
# News ingestion timeout across all concurrent feed tasks in seconds
INGESTION_TIMEOUT_SECONDS=20.0
# Yahoo Finance news items requested per sweep
YF_NEWS_COUNT=50
# Retry attempts for failed RSS feeds with backoff
FEED_RETRY_ATTEMPTS=2
# Outbound User-Agent header for HTTP feed ingestion
HTTP_USER_AGENT=SentimentPulse/1.1 (+research)

# Ticker Resolution & Caching
# In-memory TTL cache duration for resolved ticker profiles in seconds (6 hours)
TICKER_CACHE_TTL_SECONDS=21600
# Negative cache duration for invalid/unresolvable tickers in seconds (10 minutes)
TICKER_NEGATIVE_CACHE_TTL_SECONDS=600
# Maximum timeout for ticker resolution calls in seconds
TICKER_RESOLUTION_TIMEOUT_SECONDS=8.0

# Cache Buckets (in minutes, must divide 1440 evenly)
# Cache bucket interval during active trading session (15 minutes)
CACHE_INTRADAY_BUCKET_MINUTES=15
# Cache bucket interval during overnight/weekend off-market hours (60 minutes)
CACHE_OFF_MARKET_BUCKET_MINUTES=60

# Model Pricing Overrides (JSON string, USD per 1M tokens)
MODEL_PRICING={}
