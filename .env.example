# Server Environment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Database
DATABASE_URL=sqlite:///./data/sentiment.db

# Model Identifiers
FINBERT_MODEL_NAME=ProsusAI/finbert
LLM_MODEL_ID=openai/gpt-4o-mini
ENABLE_LLM=true

# External Provider Credentials
OPENROUTER_API_KEY=

# Security & Networking
TRUST_PROXY_HEADERS=false

# Budget & Token Controls
MAX_RETAINED_ARTICLES=15
MAX_LLM_CANDIDATES=5
MAX_EXCERPT_TOKENS=150
MAX_PROMPT_TOKENS=2000
MAX_COMPLETION_TOKENS=500
MAX_COST_PER_RUN_USD=0.02

# Rate Limiting
RATE_LIMIT_ANALYSIS_PER_MINUTE=15
RATE_LIMIT_JOBS_PER_MINUTE=60
